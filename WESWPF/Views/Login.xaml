<Window x:Class="WES.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WES.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Title="Login" 
        Height="440" 
        Width="640"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        FontFamily="kaiti"
        FontSize="18"
        WindowStartupLocation="CenterScreen" 
        Foreground="White"
        MouseLeftButtonDown="WinMove"
        x:Name="LoginWindow">
    <Border CornerRadius="10">
        <!--背景图-->
        <Border.Background>
            <ImageBrush ImageSource="../Assets/Images/2.png" Stretch="UniformToFill"/>
        </Border.Background>
        <Grid>
            <!--透明层-->
            <Border CornerRadius="10" BorderThickness="0" Opacity="0.65">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0 1" EndPoint="1 0">
                        <GradientStop Color="#FF426283" Offset="0"/>
                        <GradientStop Color="#FF10253A" Offset="0.75"/>
                        <GradientStop Color="#FF103355" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <!--title-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Login" Foreground="LightGray" FontFamily="Montserrat" VerticalAlignment="Center" Margin="10 0 0 0"/>
                    <!--<Button Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2" ToolTip="关闭" Click="WinClose">
                        <Button.Content>
                            <fa:IconImage Icon="Close" Foreground="White" Width="20" Height="20"/>
                        </Button.Content>
                    </Button>-->
                    <Button ToolTip="关闭" Style="{StaticResource WindowControlBtnStyle}" Height="30" Width="30" Grid.Column="2" Tag="Close" Click="WinClose"/>
                </Grid>

                <!--form-->
                <StackPanel Grid.Row="1" Width="260" Orientation="Vertical" Margin="0 -15 0 0">
                    <Image Source="../Assets/Images/透明.png"/>
                    <StackPanel HorizontalAlignment="Center" MinWidth="250">
                        <TextBlock Text="账户" Margin="0 10 0 10"/>
                        <TextBox FontSize="15" FontFamily="kaiti" Text="{Binding Account}" Width="250" Height="33">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=LoginWindow}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <TextBlock Text="密码" Margin="0 25 0 10"/>
                        <ui:PasswordBox FontSize="15" FontFamily="kaiti" Password="{Binding Password,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                            <ui:PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=LoginWindow}"/>
                            </ui:PasswordBox.InputBindings>
                        </ui:PasswordBox>

                        <TextBlock Text="{Binding TipMsg}" Margin="0 30 0 0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="OrangeRed"/>

                        <Grid Margin="0 30 0 0" Height="35">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource LoginBtnStyle}" Content="登 录" Background="#2c3e50" FontSize="22" Foreground="White" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=LoginWindow}"/>
                            <Button Style="{StaticResource LoginBtnStyle}"  Grid.Column="2" Content="注 册" Background="#2c3e50" FontSize="22" Foreground="White"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
