<Window x:Class="WES.Views.ShowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WES.Views"
        mc:Ignorable="d"
        Title="ShowWindow" 
        Height="300" 
        Width="400"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <Border Background="White" CornerRadius="3" BorderThickness="1" BorderBrush="LightGray">
        <Border.Effect>
            <DropShadowEffect Color="Gray" ShadowDepth="3" Opacity="0.5" BlurRadius="20" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Border CornerRadius="3 3 0 0" Background="#FF2A7491" MouseLeftButtonDown="WinMove">
                <Grid>
                    <TextBlock Text="提示" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" Foreground="White" Margin="8"/>
                    <Button ToolTip="关闭" HorizontalAlignment="Right" Margin="8" Style="{StaticResource WindowControlBtnStyle}" Height="24" Width="24" Tag="PowerOff" Click="CloseBtnClick"/>
                </Grid>
            </Border>

            <Border Grid.Row="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontSize="16" Text="请输入线别" HorizontalAlignment="Left"/>
                    <TextBox x:Name="LineName" Text="3" FontSize="16" Width="150" HorizontalAlignment="Left" Margin="0 15"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2">
                <Button Content="一 键 修 改" FontSize="16" Margin="10 5" Height="35" Click="ChangeClick"/>
            </Border>
        </Grid>
    </Border>
</Window>
