<UserControl x:Class="WES.Views.RackManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WES.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800"
             FontSize="15">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Border Background="White" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Border Background="LightGray" Margin="5" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel Margin="8 0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="货架编号:" VerticalAlignment="Center"/>
                            <TextBox x:Name="RackCellCode" Text="{Binding Rack.RackCellCode}" Width="140" Margin="5 0 20 0"/>
                            <TextBlock Text="行索引:" VerticalAlignment="Center"/>
                            <TextBox x:Name="RowIndex" Text="{Binding Rack.RackCellRowIndex}" Width="55" Margin="5 0 20 0"/>
                            <TextBlock Text="列索引:" VerticalAlignment="Center"/>
                            <TextBox x:Name="ColumnIndex" Text="{Binding Rack.RackCellColumnIndex}" Width="55" Margin="5 0 20 0"/>
                            <TextBlock Text="类型(正,反,特):" VerticalAlignment="Center"/>
                            <TextBox x:Name="RackCellType" Text="{Binding Rack.RackCellType}" Width="55" Margin="5 0 20 0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="查询" Margin="8 5" MinWidth="40" Command="{Binding SelectCommand}"/>
                            <Button Content="添加" Margin="8 5" MinWidth="40" Command="{Binding AddRackCommand}"/>
                            <Button Content="一键改线" Margin="8 5" MinWidth="40" Command="{Binding ChangeLineCommand}"/>
                            <Button Content="{Binding ToggleButtonText}" 
                                    Command="{Binding ToggleAdvancedSearchCommand}" 
                                    FontSize="8" Margin="2 8"/>
                        </StackPanel>
                    </Grid>
                    <!-- 高级搜索面板（默认折叠） -->
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,5" Visibility="{Binding IsAdvancedSearchExpanded, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="8 4">
                            <TextBlock Text="开始时间 从" FontSize="15"/>
                            <DatePicker Margin="20 0" SelectedDate="{Binding Rack.CreateTimeStart}" />

                            <TextBlock Text="开始时间 到" FontSize="15"/>
                            <DatePicker Margin="20 0" SelectedDate="{Binding Rack.CreateTimeEnd}" />
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="1" Margin="8 4">
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1">
                <DataGrid Background="Transparent" RowHeaderWidth="0" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" ItemsSource="{Binding Rackcells}" Margin="5" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编号" Binding="{Binding ID}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5 0 0 0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="货架编号" Binding="{Binding RackCellCode}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5 0 0 0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="行索引" Binding="{Binding RackCellRowIndex}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5 0 0 0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="列索引" Binding="{Binding RackCellColumnIndex}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5 0 0 0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="类型" Binding="{Binding RackCellType}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5 0 0 0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 定义按钮列 -->
                        <DataGridTemplateColumn Header="操作" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <UniformGrid Columns="2">
                                        <Button Margin="3" Content="编辑" Command="{Binding DataContext.EditRackCommand,RelativeSource={RelativeSource  AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Margin="3" Content="删除" Command="{Binding DataContext.DeleteRackCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </UniformGrid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 分页控件区域 -->
            <Border Grid.Row="2" Margin="5" Background="Transparent" CornerRadius="5" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Content="首页" 
                            Command="{Binding FirstPageCommand}" 
                            Margin="5" 
                            IsEnabled="{Binding CanFirstPage}"/>
                    <Button Content="上一页" 
                            Command="{Binding PreviousPageCommand}" 
                            Margin="5" 
                            IsEnabled="{Binding CanPreviousPage}"/>
                    <TextBlock Text="{Binding PageInfo}" 
                               VerticalAlignment="Center" 
                               Margin="10 0"/>
                    <Button Content="下一页" 
                            Command="{Binding NextPageCommand}" 
                            Margin="5" 
                            IsEnabled="{Binding CanNextPage}"/>
                    <Button Content="末页" 
                            Command="{Binding LastPageCommand}" 
                            Margin="5" 
                            IsEnabled="{Binding CanLastPage}"/>
                    <TextBlock Text="每页行数:" 
                               VerticalAlignment="Center" 
                               Margin="10 0 5 0"/>
                    <ComboBox ItemsSource="{Binding PageSizes}" 
                              SelectedItem="{Binding CurrentPageSize}" 
                              Width="80" 
                              Margin="0 5"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
