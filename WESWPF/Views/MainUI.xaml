<Window x:Class="WES.Views.MainUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:local="clr-namespace:WES.Views"
        mc:Ignorable="d"
        Title="MainUI"
        Height="780"
        Width="1150"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        FontFamily="kaiti"
        MinHeight="650"
        MinWidth="900"
        MouseLeftButtonDown="WinMove">
    <Border CornerRadius="5" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>
            <!--header-->
            <Border Background="#FF2A7491" CornerRadius="5 5 0 0">
                <Grid>
                    <Border Height="35" Width="110" CornerRadius="3" HorizontalAlignment="Left" Margin="10 0">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/Images/Wistron.png"/>
                        </Border.Background>
                    </Border>
                    <TextBlock FontSize="22" Text="WES" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10 0">
                        <Button ToolTip="最小化" Style="{StaticResource WindowControlBtnStyle}" Height="30" Width="30" Tag="Minimize" Click="MinBtnClick"/>
                        <Button ToolTip="最大化" Style="{StaticResource WindowControlBtnStyle}" Height="30" Width="30" Tag="Maximize" Click="MaxBtnClick"/>
                        <Button ToolTip="关闭程序" Style="{StaticResource WindowControlBtnStyle}" Height="30" Width="30" Tag="PowerOff" Click="CloseBtnClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Background="Transparent" Margin="10 20" BorderThickness="0 0 1 0" BorderBrush="LightGray">
                    <ItemsControl ItemsSource="{Binding Menus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate >
                                <RadioButton Margin="0 1" IsChecked="{Binding IsChecked}" Tag="{Binding Icon}" Content="{Binding ContentName}" Command="{Binding DataContext.NavChangeCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding PageName}" GroupName="MenuGroup" Style="{StaticResource MenuRadioButtonStyle}" Height="45"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <ContentControl Grid.Column="1" x:Name="Content" Content="{Binding MainContent}" Margin="10 20 20 20"/>
            </Grid>
            
            <!--Footer-->
            <Border Grid.Row="2" Background="#FF185C76" CornerRadius="0 0 5 5">
                <Grid>
                    <TextBlock FontSize="16" Margin="10 0" Text="華西自動化開發部·JMCR00" VerticalAlignment="Center" Foreground="White" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding CurrentTime}" HorizontalAlignment="Right" Margin="10 0" VerticalAlignment="Center" Foreground="White"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
