<UserControl x:Class="WES.Views.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:WES.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800"
             FontSize="15">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--信号灯样式-->
            <Style x:Key="SignalLamp" TargetType="Border">
                <Setter Property="Height" Value="20"/>
                <Setter Property="Width" Value="20"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Margin" Value="0 0 10 0"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="Gray" ShadowDepth="0" BlurRadius="5" Direction="0"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <ContextMenu x:Key="EXSNContextMenu">
                <MenuItem Header="上抛" Command="{Binding PlacementTarget.DataContext.ProcessFailCommand,RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="upload"/>
                <MenuItem Header="删除" Command="{Binding PlacementTarget.DataContext.ProcessFailCommand,RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="delete"/>
                <!--<MenuItem Header="一键上抛" Command="{Binding PlacementTarget.DataContext.ProcessFailCommand,RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="uploadAll"/>-->
                <MenuItem Header="一键删除" Command="{Binding PlacementTarget.DataContext.ProcessFailCommand,RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="deleteAll"/>
            </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="White" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.45*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Margin="5 0" Background="#FF66A2B6" CornerRadius="5 5 0 0" BorderThickness="1 1 1 0" BorderBrush="Gray">
                        <TextBlock Foreground="White" Text="机台信息" Margin="10 10"/>
                    </Border>
                    <Border Grid.Row="1"  Margin="5 0" Background="#FFF2F9F5" CornerRadius="0 0 5 5" BorderThickness="1 0 1 1" BorderBrush="Gray">
                        <Grid Margin="20 0">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="USN条码" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurruntUSN}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="机台类型" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Foreground="OrangeRed" Grid.Row="1" Grid.Column="1" Text="{Binding MType}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="架位信息" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurruntRockCellMSG}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="发送手臂" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PreviousRockCellMSG}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
                <GridSplitter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Grid.Column="1" Width="3"/>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Margin="5 0" Background="#FF66A2B6" CornerRadius="5 5 0 0" BorderThickness="1 1 1 0" BorderBrush="Gray">
                        <TextBlock Foreground="White" Text="功能操作" Margin="10 10"/>
                    </Border>
                    <Border Grid.Row="1"  Margin="5 0" Background="#FFF2F9F5" CornerRadius="0 0 5 5" BorderThickness="1 0 1 1" BorderBrush="Gray">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="10">
                                    <TextBlock Text="启用外箱" VerticalAlignment="Center" Margin="0 0 10 0" Width="70"/>
                                    <ToggleButton IsChecked="{Binding IsWXEnable}" Style="{StaticResource SwitchToggleButton}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="10">
                                    <TextBlock Text="ByPass" VerticalAlignment="Center" Margin="0 0 10 0" Width="70"/>
                                    <ToggleButton IsChecked="{Binding IsByPass}" Style="{StaticResource SwitchToggleButton}"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="程序复位" Command="{Binding FunctionCommand}" CommandParameter="reset" Margin="10"/>
                                    <!--<Button Content="拍照异常" Command="{Binding FunctionCommand}" Margin="10"/>
                                    <Button Content="扫码重连" Command="{Binding FunctionCommand}" CommandParameter="scannerRelink" Margin="10"/>
                                    <Button Content="外箱服务重启" Command="{Binding FunctionCommand}" CommandParameter="wxrestart" Margin="10"/>
                                    <Button Content="手臂服务重启" Command="{Binding FunctionCommand}" CommandParameter="robotrestart" Margin="10"/>
                                    <Button Content="旋转平台重连" Command="{Binding FunctionCommand}" CommandParameter="rprelink" Margin="10"/>-->
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <!--<TabControl Grid.Column="2" Grid.ColumnSpan="3" Background="#FF66A2B6">
                    <TabItem Header="良率统计" Background="#FF66A2B6">
                    </TabItem>
                    <TabItem Header="功能操作" Background="#FF66A2B6">
                        <Border Grid.Row="1"  Margin="5 0" Background="#FFF2F9F5" CornerRadius="0 0 5 5" BorderThickness="1 0 1 1" BorderBrush="Gray">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="10">
                                        <TextBlock Text="启用外箱" VerticalAlignment="Center" Margin="0 0 10 0" Width="70"/>
                                        <ToggleButton IsChecked="{Binding IsWXEnable}" Style="{StaticResource SwitchToggleButton}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="10">
                                        <TextBlock Text="ByPass" VerticalAlignment="Center" Margin="0 0 10 0" Width="70"/>
                                        <ToggleButton IsChecked="{Binding IsByPass}" Style="{StaticResource SwitchToggleButton}"/>
                                    </StackPanel>
                                    <WrapPanel>
                                        <Button Content="程序复位" Command="{Binding FunctionCommand}" CommandParameter="reset" Margin="10"/>
                                        <Button Content="拍照异常" Command="{Binding FunctionCommand}" Margin="10"/>
                                        <Button Content="扫码重连" Command="{Binding FunctionCommand}" CommandParameter="scannerRelink" Margin="10"/>
                                        <Button Content="外箱服务重启" Command="{Binding FunctionCommand}" CommandParameter="wxrestart" Margin="10"/>
                                        <Button Content="手臂服务重启" Command="{Binding FunctionCommand}" CommandParameter="robotrestart" Margin="10"/>
                                        <Button Content="旋转平台重连" Command="{Binding FunctionCommand}" CommandParameter="rprelink" Margin="10"/>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                    <TabItem Header="上抛失败" Background="#FF66A2B6"/>
                </TabControl>-->

                <GridSplitter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="3" Width="3"/>
                
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Margin="5 0" Background="#FF66A2B6" CornerRadius="5 5 0 0" BorderThickness="1 1 1 0" BorderBrush="Gray">
                        <TextBlock Foreground="White" Text="上传失败" Margin="10 10"/>
                    </Border>
                    <Border Grid.Row="1"  Margin="5 0" Background="#FFF2F9F5" CornerRadius="0 0 5 5" BorderThickness="1 0 1 1" BorderBrush="Gray">
                        <ListView DisplayMemberPath="USN" SelectedItem="{Binding SelectModel, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding UploadFailMSG}" ContextMenu="{StaticResource EXSNContextMenu}"/>
                    </Border>
                </Grid>
            </Grid>

            <GridSplitter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="1" Height="3" Margin="5 0" FocusVisualStyle="{x:Null}"/>

            <Border Background="#FF2A7491" Grid.Row="2" Margin="5 0" Height="45" CornerRadius="5 5 0 0" VerticalAlignment="Top">
                <Grid>
                    <TextBlock Foreground="White" Text="运行日志：" Margin="5 0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Foreground="White" Text="扫码枪" Margin="10 0"/>
                        <Border x:Name="ScannerLight" Margin="10 0" Style="{StaticResource SignalLamp}" Background="{Binding ScannerStatus}" Height="15" Width="15"/>
                        <TextBlock Foreground="White" Text="外箱连接" Margin="10 0"/>
                        <Border x:Name="wxLight" Margin="10 0" Style="{StaticResource SignalLamp}" Background="{Binding WXStatus}" Height="15" Width="15"/>
                        <TextBlock Foreground="White" Text="手臂" Margin="10 0"/>
                        <Border x:Name="robotLight" Margin="10 0" Style="{StaticResource SignalLamp}" Background="{Binding RobotStatus}" Height="15" Width="15"/>
                        <TextBlock Foreground="White" Text="旋转平台" Margin="10 0"/>
                        <Border x:Name="plcLight" Margin="0 0 10 0" Style="{StaticResource SignalLamp}" Background="{Binding RotatingPlatformStatus}" Height="15" Width="15"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!--<Button Content="测试" Command="{Binding TestCommand}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20 0"/>-->
            <Border BorderBrush="Gray" BorderThickness="1" Grid.Row="2"  Margin="5 45 5 0" CornerRadius="0 0 5 5">
                <ListBox x:Name="LogsListBox" ItemsSource="{Binding Logs}" Margin="5" BorderThickness="0"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
