<UserControl x:Class="WES.Views.Manual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WES.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="800"
             FontSize="18"
             FontFamily="kaiti">
    <Border CornerRadius="5" Background="#FFF2F9F5" Padding="0">
        <Grid Margin="20 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="手动操作" FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
            <Border BorderBrush="LightGray" BorderThickness="0 0 0 1"/>
            <ScrollViewer Margin="0 20 0 0" Grid.Row="1" FocusVisualStyle="{x:Null}">
                <!--<Grid Margin="20 10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="扫码枪" VerticalAlignment="Top" FontWeight="Bold" Foreground="Gray" Margin="10 0 0 0"/>

                    <Button Grid.Row="1" FontSize="16" Tag="" Content="触发扫码"/>
                </Grid>-->
                <StackPanel>
                    <TextBlock Text="扫码枪" VerticalAlignment="Top" FontWeight="Bold" Foreground="Gray" Margin="10 0 0 0"/>
                    <Border Height="200" Background="LightGray" Margin="10" CornerRadius="5">
                        <WrapPanel>
                            <Button Command="{Binding UserCommand}" CommandParameter="trigger" Content="触发扫码" Margin="10"/>
                        </WrapPanel>
                    </Border>

                    <Border BorderThickness="1" BorderBrush="LightGray" Margin="10 20"/>
                    
                    <TextBlock Text="旋转平台" VerticalAlignment="Top" FontWeight="Bold" Foreground="Gray" Margin="10 0"/>
                    <Border Background="LightGray" CornerRadius="5" Padding="20 15" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="平台状态" Margin="0"/>
                            <TextBlock Margin="30 0" Text="{Binding RPStatus}" Foreground="DeepSkyBlue"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Height="200" Background="LightGray" Margin="10" CornerRadius="5">
                        <WrapPanel>
                            <Button Command="{Binding UserCommand}" CommandParameter="writeTrigger" Content="写入扫码信号" Margin="10"/>
                            <Button Command="{Binding UserCommand}" CommandParameter="scannerOK" Content="模拟扫码完成" Margin="10"/>
                            <Button Command="{Binding UserCommand}" CommandParameter="small" Content="小机台旋转" Margin="10"/>
                            <Button Command="{Binding UserCommand}" CommandParameter="big" Content="大机台旋转" Margin="10"/>
                            <Button Command="{Binding UserCommand}" CommandParameter="query" Content="寄存器地址查询" Margin="10"/>
                        </WrapPanel>
                    </Border>

                    <Border BorderThickness="1" BorderBrush="LightGray" Margin="10 20"/>

                    <TextBlock Text="SFCS" VerticalAlignment="Top" FontWeight="Bold" Foreground="Gray" Margin="10 0"/>
                    <Border Height="200" Background="LightGray" Margin="10" CornerRadius="5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBox Height="35" Text="{Binding OldCode}" Width="245"/>
                                <TextBlock Text="---->" VerticalAlignment="Center" Margin="20 0"/>
                                <TextBox Height="35" Text="{Binding NewCode}" Width="245"/>
                                <Button  Command="{Binding UserCommand}" CommandParameter="convert" Content="条码转换" Margin="30 10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border BorderThickness="1" BorderBrush="LightGray" Margin="10 20"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
