<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
                    xmlns:converters="clr-namespace:WES.Converters">
    <converters:HasItemsToVisibilityConverter x:Key="HasItemsToVisibilityConverter"/>
    <converters:BoolToIconConverter x:Key="BoolToIconConverter"/>

    <!--窗体控制按钮样式-->
    <ControlTemplate TargetType="{x:Type Button}" x:Key="WindowControlBtnTemplate">
        <Border Background="{TemplateBinding Background}" x:Name="Back" CornerRadius="5">
            <fa:IconImage Icon="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=Button}}" Foreground="White" Height="20" Width="20"/>
            <!--<md:PackIcon Kind="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>-->
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#22FFFFFF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#44FFFFFF"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="Button" x:Key="WindowControlBtnStyle">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="8 0 0 0"/>
        <Setter Property="Width" Value="45"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template" Value="{StaticResource WindowControlBtnTemplate}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- 自定义的 RadioButton 菜单样式 -->
    <Style x:Key="MenuRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#666666" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="BorderThickness" Value="0 0 1 0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent" CornerRadius="0" Name="back" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 图标 -->
                            <fa:IconBlock x:Name="icon" Icon="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- 菜单文本 -->
                            <TextBlock Grid.Column="1" x:Name="content" Text="{TemplateBinding Content}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10 0 20 0" FontWeight="Black"/>
                        </Grid>
                    </Border>
                    <!-- 控件触发器 -->
                    <ControlTemplate.Triggers>
                        <!-- 选中状态样式 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="#FF2A7491" TargetName="icon" />
                            <Setter Property="Foreground" Value="#FF2A7491" TargetName="content" />
                            <Setter Property="BorderBrush" Value="#FF2A7491" TargetName="back" />
                            <Setter Property="BorderThickness" Value="0 0 1 0" TargetName="back" />
                        </Trigger>
                        <!-- 鼠标悬浮状态 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--普通文本框样式-->
    <SolidColorBrush x:Key="TextBox.Static.Border" Color="#FFABAdB3"/>
    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#FF7EB4EA"/>
    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#FF569DE5"/>
    <Style TargetType="TextBox">
        <Setter Property="Width" Value="200"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="3" Padding="10 3" x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ScrollViewer VerticalAlignment="Center" x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.MouseOver.Border}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="true">
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.Focus.Border}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--普通Button样式-->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#006789"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="3" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding Background}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="LightGray" ShadowDepth="3" Opacity="0.5" BlurRadius="20" Direction="270"/>
                        </Border.Effect>
                        <TextBlock VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" x:Name="content" Text="{TemplateBinding Content}" Margin="8 5 8 3"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="border" Property="Background" Value="#FF137DA0"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <!--<Setter TargetName="text" Property="Foreground" Value="White"/>
                            <Setter TargetName="icon" Property="Foreground" Value="White"/>-->
                            <Setter TargetName="border" Property="Background" Value="#FF065B77"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--带图标的button样式-->
    <Style x:Key="IconBttonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#006789"/>
        <Setter Property="Template" Value="{DynamicResource IconButtonControlTemplate}"/>
    </Style>
    <ControlTemplate x:Key="IconButtonControlTemplate" TargetType="Button">
        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="5">
            <Border.Effect>
                <DropShadowEffect Color="LightGray" ShadowDepth="3" Opacity="0.5" BlurRadius="20" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <fa:IconImage Foreground="{TemplateBinding Foreground}" x:Name="icon" Icon="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=Button}}" Height="15" Width="15"/>
                <!--<md:PackIcon Width="18" Height="18" Kind="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>-->
                <TextBlock x:Name="text" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="Background" Value="#FF137DA0"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <!--<Setter TargetName="text" Property="Foreground" Value="White"/>
                <Setter TargetName="icon" Property="Foreground" Value="White"/>-->
                <Setter TargetName="border" Property="Background" Value="#FF065B77"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--切换按钮ToggButton-->
    <Style x:Key="SwitchToggleButton" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="48" Height="24">
                        <!-- 使用圆角矩形作为背景 -->
                        <Border x:Name="BackgroundBorder" CornerRadius="12" BorderBrush="Gray" BorderThickness="0">
                            <Border.Background>
                                <SolidColorBrush Color="#E5E5E5"/>
                            </Border.Background>
                        </Border>
                        <!-- 圆形滑块 -->
                        <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbTransform" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <!-- 滑块回到左边 -->
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"/>
                                        <!-- 背景颜色变为灰色 -->
                                        <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#E5E5E5" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <!-- 滑块移动到右边 -->
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.2"/>
                                        <!-- 背景颜色变为绿色 -->
                                        <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="LimeGreen" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--提示气泡-->
    <Style TargetType="ToolTip">
        <Setter Property="ToolTipService.BetweenShowDelay" Value="1"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="1"/>
        <Setter Property="FontFamily" Value="微软雅黑"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter x:Name="content" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--登录按钮样式-->
    <Style TargetType="Button" x:Key="LoginBtnStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border  x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Direction="0" ShadowDepth="0" Color="#FFDADADA" />
                        </Border.Effect>
                        <ContentPresenter x:Name="contentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="border" Value="#458FAD"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="#1B5369"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="border" Value="#1B5369"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="#458FAD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 二级菜单样式（缩进+浅色） -->
    <Style x:Key="SubMenuRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource MenuRadioButtonStyle}">
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- 展开/折叠按钮样式 -->
    <Style x:Key="ExpandToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <fa:IconBlock 
                    Icon="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, 
                           Converter={StaticResource BoolToIconConverter}}" 
                    Foreground="#666666" FontSize="12"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>