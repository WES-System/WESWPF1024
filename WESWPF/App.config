<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<!--计时器间隔(单位:S/秒)-->
		<add key="TimeInterval" value="1" />
		<!--线别-->
		<add key="Line" value="DA3" />
		<!--Hik手臂-->
		<add key="RobotIP" value="127.0.0.1" />
		<add key="RobotPort" value="7930" />
		<!--外箱检测机-->
		<add key="WXCMIP" value="127.0.0.1" />
		<add key="WXCMPort" value="8765" />
		<!--气缸PLC-->
		<add key="CylinderIP" value="127.0.0.1" />
		<add key="CylinderPort" value="502" />
		<!--森林系统-->
		<add key="FSIP" value="127.0.0.1" />
		<add key="FSPort" value="1234" />
		<!--扫码枪-->
		<add key="BarcodeIP" value="127.0.0.1" />
		<add key="BarcodePort" value="2001" />
		<!--旋转平台-->
		<add key="RotatingPlatformIP" value="127.0.0.1" />
		<add key="RotatingPlatformPort" value="502" />
		<!--码板机编号 其他场景为空-->
		<add key="PackMachineNo" value="" />
		<!--使用场景 0:码垛入库 1:理货 2:自动出库 3:手动出库-->
		<add key="Scene" value="0" />
		<!--手臂流程开始触发字符-->
		<add key="RobotTriggerSrt" value="InboundStart" />
		<!--扫码枪扫码触发字符-->
		<add key="ScannerTriggerStr" value="photo" />
		<!--获取机台架位接口-->
		<add key="GetShelfPoint_URL" value="http://10.60.209.99:22222/Wincc/AllocateBox" />
		<!--外箱结果上传接口-->
		<add key="WXUpload_URL" value="http://10.60.209.99:22222/Wincc/AnnounceWX" />
		<!--机台入库完成接口-->
		<add key="CompleteUpload_URL" value="http://10.60.209.99:22222/Wincc/Arm" />
	</appSettings>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<system.serviceModel>
		<bindings>
   <basicHttpBinding>
    <binding name="WebServiceSoap" />
    <binding name="WebServiceSoap1" />
   </basicHttpBinding>
  </bindings>
  <client>
   <endpoint address="http://10.60.203.50/Tester.WebService/WebService.asmx" binding="basicHttpBinding" bindingConfiguration="WebServiceSoap" contract="SFCS_Server.WebServiceSoap" name="WebServiceSoap" />
   <endpoint address="http://10.60.23.108/Tester.WebService/WebService.asmx" binding="basicHttpBinding" bindingConfiguration="WebServiceSoap1" contract="UploadData.WebServiceSoap" name="WebServiceSoap1" />
  </client>
	</system.serviceModel>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-9.0.0.8" newVersion="9.0.0.8" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-9.0.0.8" newVersion="9.0.0.8" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.2.0.1" newVersion="4.2.0.1" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.ValueTuple" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>